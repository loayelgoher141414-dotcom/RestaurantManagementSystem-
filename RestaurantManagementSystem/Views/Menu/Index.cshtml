@model List<RestaurantManagementSystem.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";

    var categories = Model?
        .Where(x => !string.IsNullOrWhiteSpace(x.Category))
        .GroupBy(x => x.Category.Trim())
        .OrderBy(x => x.Key)
        .ToList()
        ?? new List<IGrouping<string, RestaurantManagementSystem.Models.MenuItem>>();
}

<style>

    /* =====================================================
           MENU PAGE
        ===================================================== */

    .menu-page {
        min-height: calc(100vh - 70px);
        /* Space below the Employee Navbar */
        padding: 75px 4% 40px;
        background: radial-gradient( circle at top right, rgba(139,0,0,0.08), transparent 35% ), #0d0d0d;
        color: white;
    }


    /* =====================================================
           HEADER
        ===================================================== */

    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 45px;
        padding-bottom: 25px;
        border-bottom: 1px solid #292929;
    }

        .menu-header h2 {
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
        }

            .menu-header h2 span {
                color: #8b0000;
            }

        .menu-header p {
            color: #777;
            margin: 8px 0 0;
            font-size: 0.95rem;
        }


    /* =====================================================
           ADD BUTTON
        ===================================================== */

    .btn-add-menu {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #8b0000;
        color: white;
        border: none;
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        box-shadow: 0 8px 20px rgba(139,0,0,0.2);
        transition: 0.25s;
    }

        .btn-add-menu:hover {
            background: #b22222;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(139,0,0,0.3);
        }


    /* =====================================================
           CATEGORY SECTION
        ===================================================== */

    .category-section {
        margin-bottom: 55px;
    }


    /* =====================================================
           CATEGORY HEADER
        ===================================================== */

    .category-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

    .category-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #f1f1f1;
        white-space: nowrap;
    }

        .category-title::before {
            content: "";
            display: block;
            width: 4px;
            height: 25px;
            background: #8b0000;
            border-radius: 5px;
        }

    .category-line {
        height: 1px;
        background: linear-gradient( to right, #333, transparent );
        flex: 1;
    }

    .category-count {
        color: #777;
        font-size: 0.8rem;
        white-space: nowrap;
    }


    /* =====================================================
           MENU CARD
        ===================================================== */

    .menu-card {
        height: 100%;
        background: linear-gradient( 145deg, #151515, #101010 );
        border: 1px solid #292929;
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    }

        .menu-card:hover {
            transform: translateY(-7px);
            border-color: #4a4a4a;
            box-shadow: 0 18px 40px rgba(0,0,0,0.55);
        }


    /* =====================================================
           IMAGE
        ===================================================== */

    .menu-image-container {
        position: relative;
        height: 220px;
        overflow: hidden;
        background: #181818;
    }

    .menu-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .menu-card:hover .menu-image {
        transform: scale(1.07);
    }


    /* Image Overlay */

    .menu-image-container::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 45%;
        background: linear-gradient( to top, rgba(0,0,0,0.65), transparent );
        pointer-events: none;
    }


    /* =====================================================
           CATEGORY BADGE
        ===================================================== */

    .category-badge {
        position: absolute;
        top: 13px;
        left: 13px;
        z-index: 2;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(5px);
        color: #eee;
        border: 1px solid rgba(255,255,255,0.15);
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }


    /* =====================================================
           CARD BODY
        ===================================================== */

    .menu-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        min-height: 230px;
    }


    /* =====================================================
           ITEM NAME
        ===================================================== */

    .menu-card-title {
        color: white;
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 8px;
    }


    /* =====================================================
           DESCRIPTION
        ===================================================== */

    .menu-description {
        color: #858585;
        font-size: 0.88rem;
        line-height: 1.55;
        min-height: 43px;
        margin-bottom: 15px;
    }


    /* =====================================================
           PRICE
        ===================================================== */

    .menu-price {
        color: #e1e1e1;
        font-size: 1.15rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

        .menu-price span {
            color: #8b0000;
            font-size: 0.75rem;
            font-weight: 600;
        }


    /* =====================================================
           AVAILABILITY
        ===================================================== */

    .availability {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
        margin-bottom: 15px;
    }

        .availability::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .available {
        background: rgba(25,135,84,0.12);
        color: #75d6a1;
        border: 1px solid rgba(25,135,84,0.25);
    }

        .available::before {
            background: #45c47a;
        }

    .not-available {
        background: rgba(220,53,69,0.12);
        color: #ff8f9b;
        border: 1px solid rgba(220,53,69,0.25);
    }

        .not-available::before {
            background: #dc3545;
        }


    /* =====================================================
           ACTIONS
        ===================================================== */

    .menu-actions {
        margin-top: auto;
        padding-top: 13px;
        border-top: 1px solid #292929;
        display: flex;
        gap: 8px;
    }

    .btn-edit,
    .btn-delete {
        flex: 1;
        text-align: center;
        padding: 7px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
        transition: 0.2s;
    }


    .btn-edit {
        background: #252525;
        color: #ddd;
        border: 1px solid #3a3a3a;
    }

        .btn-edit:hover {
            background: #333;
            color: white;
        }


    .btn-delete {
        background: transparent;
        color: #dc3545;
        border: 1px solid #5c2228;
    }

        .btn-delete:hover {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
        }


    /* =====================================================
           EMPTY MENU
        ===================================================== */

    .empty-menu {
        text-align: center;
        padding: 90px 20px;
        background: linear-gradient( 145deg, #151515, #101010 );
        border: 1px solid #292929;
        border-radius: 15px;
        color: #777;
    }

        .empty-menu h4 {
            color: #aaa;
            margin-bottom: 8px;
        }


    /* =====================================================
           NO IMAGE
        ===================================================== */

    .no-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 0.85rem;
        background: repeating-linear-gradient( 45deg, #151515, #151515 10px, #181818 10px, #181818 20px );
    }


    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media (max-width: 768px) {

        .menu-page {
            padding: 25px 15px;
        }

        .menu-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
            margin-bottom: 35px;
        }

            .menu-header h2 {
                font-size: 1.8rem;
            }

        .btn-add-menu {
            width: 100%;
            justify-content: center;
        }

        .category-title {
            font-size: 1.25rem;
        }

        .category-count {
            display: none;
        }

        .menu-image-container {
            height: 210px;
        }
    }

</style>


<div class="menu-page">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="menu-header">

        <div>

            <h2>
                Our <span>Menu</span>
            </h2>

            <p>
                Explore our delicious meals and drinks.
            </p>

        </div>


        @if (User.IsInRole("Employee"))
        {
            <a asp-action="AddItems"
               class="btn-add-menu">

                <span>+</span>
                Add Menu Item

            </a>
        }

    </div>


    <!-- =====================================================
         EMPTY MENU
    ====================================================== -->
    @if (Model == null || !Model.Any())
    {
        <div class="empty-menu">

            <h4>
                No Menu Items
            </h4>

            <p>
                There are currently no items available in the menu.
            </p>

        </div>
    }
    else
    {

        <!-- =================================================
             CATEGORIES
        ================================================== -->
        @foreach (var category in categories)
        {

            <section class="category-section">


                <!-- CATEGORY HEADER -->

                <div class="category-header">

                    <h3 class="category-title">
                        @category.Key
                    </h3>

                    <div class="category-line"></div>

                    <span class="category-count">
                        @category.Count()
                        @(category.Count() == 1 ? "Item" : "Items")
                    </span>

                </div>


                <!-- ITEMS -->

                <div class="row g-4">

                    @foreach (var item in category)
                    {

                        <div class="col-xl-4 col-md-6">

                            <div class="menu-card">


                                <!-- ================= IMAGE ================= -->

                                <div class="menu-image-container">

                                    @if (!string.IsNullOrEmpty(item.ItemImage))
                                    {
                                        <img src="@item.ItemImage"
                                             class="menu-image"
                                             alt="@item.ItemName" />
                                    }
                                    else
                                    {
                                        <div class="no-image">
                                            No Image
                                        </div>
                                    }


                                    <span class="category-badge">
                                        @item.Category
                                    </span>

                                </div>


                                <!-- ================= BODY ================= -->

                                <div class="menu-card-body">


                                    <!-- NAME -->

                                    <h5 class="menu-card-title">
                                        @item.ItemName
                                    </h5>


                                    <!-- DESCRIPTION -->

                                    <p class="menu-description">

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            @item.Description
                                        }
                                        else
                                        {
                                            <span>No description available.</span>
                                        }

                                    </p>


                                    <!-- PRICE -->

                                    <div class="menu-price">

                                        @item.ItemPrice.ToString("0.00")
                                        <span>EGP</span>

                                    </div>


                                    <!-- AVAILABILITY -->
                                    @if (item.Availability)
                                    {
                                        <span class="availability available">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="availability not-available">
                                            Not Available
                                        </span>
                                    }


                                    <!-- EMPLOYEE ACTIONS -->
                                    @if (User.IsInRole("Employee"))
                                    {
                                        <div class="menu-actions">

                                            <a asp-action="EditItem"
                                               asp-route-id="@item.ItemId"
                                               class="btn-edit">

                                                Edit

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.ItemId"
                                               class="btn-delete">

                                                Delete

                                            </a>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    }

                </div>

            </section>

        }

    }

</div>