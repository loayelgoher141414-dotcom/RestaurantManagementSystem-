@model RestaurantManagementSystem.Models.ApplicationUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="rms-page">

    <!-- Header -->
    <div class="rms-page-header mb-4">

        <div>
            <h2 class="rms-title">
                Delete User
            </h2>

            <p class="rms-subtitle">
                Remove this user from the restaurant system
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-light">
            ← Back to Users
        </a>

    </div>


    <!-- Warning -->
    <div class="rms-warning mb-4">

        <div class="warning-icon">
            !
        </div>

        <div>
            <h5>
                Are you sure you want to delete this user?
            </h5>

            <p class="mb-0">
                This action cannot be undone.
            </p>
        </div>

    </div>


    <!-- User Card -->
    <div class="rms-card">

        <div class="rms-card-header">

            <div>
                <h5 class="mb-1 text-white">
                    User Information
                </h5>

                <small class="text-secondary">
                    Review the account before deleting it
                </small>
            </div>

        </div>


        <div class="rms-card-body">

            <!-- User Name -->
            <div class="user-profile">

                <div class="user-avatar">
                    @Model.Name?.Substring(0, 1).ToUpper()
                </div>

                <div>
                    <h4 class="text-white mb-1">
                        @Model.Name
                    </h4>

                    <span class="text-secondary">
                        @Model.UserName
                    </span>
                </div>

            </div>


            <hr class="rms-divider" />


            <!-- User Details -->
            <div class="row">

                <!-- Username -->
                <div class="col-md-6 mb-4">

                    <div class="detail-label">
                        Username
                    </div>

                    <div class="detail-value">
                        @Model.UserName
                    </div>

                </div>


                <!-- Email -->
                <div class="col-md-6 mb-4">

                    <div class="detail-label">
                        Email
                    </div>

                    <div class="detail-value">
                        @(Model.Email ?? "Not provided")
                    </div>

                </div>


                <!-- Phone -->
                <div class="col-md-6 mb-4">

                    <div class="detail-label">
                        Phone
                    </div>

                    <div class="detail-value">
                        @(Model.PhoneNumber ?? "Not provided")
                    </div>

                </div>


                <!-- Role -->
                <div class="col-md-6 mb-4">

                    <div class="detail-label">
                        Role
                    </div>

                    <div class="detail-value">

                        @if (ViewBag.CurrentRole == "Employee")
                        {
                            <span class="badge bg-danger">
                                Employee
                            </span>
                        }
                        else if (ViewBag.CurrentRole == "Customer")
                        {
                            <span class="badge bg-info">
                                Customer
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @(ViewBag.CurrentRole ?? "Unknown")
                            </span>
                        }

                    </div>

                </div>


                <!-- Branch -->
                <div class="col-md-6 mb-4">

                    <div class="detail-label">
                        Branch
                    </div>

                    <div class="detail-value">
                        @(Model.Branch?.Address ?? "Not assigned")
                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="rms-form-actions mt-2">

                <form asp-action="Delete"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger px-4">

                        Delete User

                    </button>

                </form>


                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    Cancel

                </a>

            </div>

        </div>

    </div>

</div>


<style>

    /* ================= PAGE ================= */

    .rms-page {
        padding: 10px 0 40px;
        color: white;
    }


    /* ================= HEADER ================= */

    .rms-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .rms-title {
        color: white;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .rms-subtitle {
        color: #777;
        margin-bottom: 0;
    }


    /* ================= WARNING ================= */

    .rms-warning {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        background: rgba(139, 0, 0, .12);
        border: 1px solid #6d0000;
        border-radius: 8px;
    }

        .rms-warning h5 {
            color: #ff6b6b;
            margin-bottom: 4px;
        }

        .rms-warning p {
            color: #999;
        }

    .warning-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #8b0000;
        color: white;
        border-radius: 50%;
        font-size: 22px;
        font-weight: bold;
        flex-shrink: 0;
    }


    /* ================= CARD ================= */

    .rms-card {
        background: #111;
        border: 1px solid #292929;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,.25);
    }

    .rms-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #292929;
        background: #151515;
    }

    .rms-card-body {
        padding: 25px;
    }


    /* ================= USER PROFILE ================= */

    .user-profile {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-avatar {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #8b0000;
        color: white;
        border-radius: 50%;
        font-size: 23px;
        font-weight: bold;
        text-transform: uppercase;
    }


    /* ================= DETAILS ================= */

    .rms-divider {
        border-color: #292929;
        margin: 25px 0;
    }

    .detail-label {
        color: #777;
        font-size: .85rem;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #eee;
        font-size: 1rem;
        font-weight: 500;
    }


    /* ================= ACTIONS ================= */

    .rms-form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid #292929;
    }

    .btn-danger {
        background-color: #8b0000;
        border-color: #8b0000;
    }

        .btn-danger:hover {
            background-color: #b22222;
            border-color: #b22222;
        }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 768px) {

        .rms-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .rms-card-body {
            padding: 18px;
        }

        .rms-warning {
            align-items: flex-start;
        }

        .rms-form-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .rms-form-actions .btn,
            .rms-form-actions form {
                width: 100%;
            }

                .rms-form-actions form .btn {
                    width: 100%;
                }
    }

</style>