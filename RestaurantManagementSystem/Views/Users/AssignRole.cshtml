@model RestaurantManagementSystem.Models.User

@{
    ViewData["Title"] = "Assign Role";
}

<div class="container mt-4">

    <h2>Assign Role</h2>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="AssignRole" method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.UserId" />

                <!-- User Name -->
                <div class="mb-3">
                    <label class="form-label">
                        User Name
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.UserName"
                           readonly />
                </div>

                <!-- Current Role -->
                <div class="mb-3">
                    <label class="form-label">
                        Current Role
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Role"
                           readonly />
                </div>

                <!-- New Role -->
                <div class="mb-3">
                    <label for="role"
                           class="form-label">
                        Assign Role
                    </label>

                    <select id="role"
                            name="role"
                            class="form-select">

                        @foreach (var role in ViewBag.Roles)
                        {
                            <option value="@role"
                                    selected="@(Model.Role == role)">
                                @role
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Role"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Role
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>