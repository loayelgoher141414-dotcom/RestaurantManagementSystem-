@model AddOrderVM

<div class="container mt-4">

    <h3 class="mb-4">Create New Order</h3>

    <form method="post" asp-action="SaveOrder" asp-controller="Order">

        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label"></label>
                    <input type="number" asp-for="UserId" class="form-control" />
                </div>

                <div class="mb-0">
                    <label asp-for="BranchId" class="form-label"></label>
                    <select name="BranchId" class="form-select">
                        <option value="">-- Select a branch --</option>
                        @foreach (var branch in Model.Branches)
                        {
                            <option value="@branch.BranchId">@branch.Address</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        @{
            int i = 0;
        }

        @foreach (var categoryGroup in Model.AvailableMenuItems.GroupBy(x => x.Category))
        {
            <h4 class="mt-4">@categoryGroup.Key</h4>

            <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
                @foreach (var item in categoryGroup)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.ItemName</h5>
                                <div class="card h-100">
                                    <img src="@item.ItemImage"
                                         class="card-img-top"
                                         alt="@item.ItemName"
                                         style="height: 200px; object-fit: cover;" />
                                </div>
                                <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                                <p class="card-text fw-bold">@item.ItemPrice.ToString("0.00") EGP</p>

                                <input type="hidden" name="Items[@i].ItemId" value="@item.ItemId" />

                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" name="Items[@i].IsSelected" value="True" id="check-@i" />
                                        <label class="form-check-label" for="check-@i">Add</label>
                                    </div>
                                    <input type="number" name="Items[@i].Quantity" value="1" min="1" class="form-control form-control-sm" style="width: 80px;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    i++;
                }
            </div>
        }

        <button class="btn btn-success" type="submit">Submit Order</button>

    </form>
</div>



