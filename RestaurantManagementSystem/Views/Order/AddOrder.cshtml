@model AddOrderVM

@{
    ViewData["Title"] = "Create Order";
}

<style>

    /* ================= ORDER PAGE ================= */

    .order-page {
        background-color: #0d0d0d;
        min-height: calc(100vh - 65px);
        padding: 35px 5%;
        color: white;
    }


    /* ================= HEADER ================= */

    .order-header {
        margin-bottom: 30px;
    }

        .order-header h2 {
            margin-top: 65px;
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .order-header p {
            color: #888;
            margin: 0;
        }


    /* ================= MESSAGE ================= */

    .rms-alert {
        background-color: #241010;
        border: 1px solid #8b0000;
        color: #ffb3b3;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 25px;
    }


    /* ================= BRANCH ================= */

    .branch-card {
        background-color: #111;
        border: 1px solid #292929;
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 40px;
    }

    .branch-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .rms-select {
        background-color: #0d0d0d;
        color: white;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 12px;
    }

        .rms-select:focus {
            background-color: #0d0d0d;
            color: white;
            border-color: #8b0000;
            box-shadow: 0 0 0 0.2rem rgba(139, 0, 0, 0.2);
        }


    /* ================= CATEGORY ================= */

    .category-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 40px 0 20px;
    }

        .category-title h4 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
        }

    .category-line {
        height: 2px;
        flex: 1;
        background: linear-gradient( to right, #8b0000, transparent );
    }


    /* ================= MENU CARD ================= */

    .menu-card {
        background-color: #111;
        border: 1px solid #292929;
        border-radius: 15px;
        overflow: hidden;
        height: 100%;
        transition: 0.25s ease;
    }

        .menu-card:hover {
            transform: translateY(-5px);
            border-color: #8b0000;
            box-shadow: 0 8px 25px rgba(139, 0, 0, 0.15);
        }


    /* ================= IMAGE ================= */

    .menu-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        display: block;
    }

    .no-image {
        width: 100%;
        height: 210px;
        background-color: #191919;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
        font-size: 0.9rem;
    }


    /* ================= CARD BODY ================= */

    .menu-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        height: calc(100% - 210px);
    }

    .menu-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: white;
        margin-bottom: 8px;
    }

    .menu-description {
        color: #888;
        font-size: 0.9rem;
        min-height: 42px;
        margin-bottom: 12px;
    }

    .menu-price {
        color: #dc3545;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 18px;
    }


    /* ================= SELECT ================= */

    .select-item {
        background-color: #191919;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
    }

        .select-item:hover {
            border-color: #8b0000;
        }

        .select-item label {
            color: #ddd;
            cursor: pointer;
        }

    .form-check-input {
        background-color: #0d0d0d;
        border-color: #555;
    }

        .form-check-input:checked {
            background-color: #8b0000;
            border-color: #8b0000;
        }


    /* ================= QUANTITY ================= */

    .quantity-label {
        color: #aaa;
        font-size: 0.85rem;
        margin-bottom: 6px;
    }

    .quantity-input {
        background-color: #0d0d0d;
        color: white;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 10px;
    }

        .quantity-input:focus {
            background-color: #0d0d0d;
            color: white;
            border-color: #8b0000;
            box-shadow: none;
        }


    /* ================= BUTTONS ================= */

    .order-actions {
        margin-top: 45px;
        padding-top: 25px;
        border-top: 1px solid #292929;
    }

    .btn-submit-order {
        background-color: #8b0000;
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-submit-order:hover {
            background-color: #b22222;
            color: white;
            transform: translateY(-2px);
        }

    .btn-cancel-order {
        background-color: #222;
        color: #ccc;
        border: 1px solid #444;
        padding: 12px 28px;
        border-radius: 8px;
        margin-left: 8px;
    }

        .btn-cancel-order:hover {
            background-color: #333;
            color: white;
        }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 768px) {

        .order-page {
            padding: 25px 18px;
        }

        .order-header h2 {
            font-size: 1.8rem;
        }

        .category-title h4 {
            font-size: 1.3rem;
        }

        .order-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-cancel-order {
            margin-left: 0;
        }
    }

</style>


<div class="order-page">

    <!-- ================= HEADER ================= -->

    <div class="order-header">

        <h2>
            Create New Order
        </h2>

        <p>
            Choose your branch and select your favorite meals.
        </p>

    </div>


    <!-- ================= MESSAGE ================= -->
    @if (TempData["Message"] != null)
    {
        <div class="rms-alert">

            @TempData["Message"]

        </div>
    }


    <form asp-controller="Order"
          asp-action="SaveOrder"
          method="post">

        @Html.AntiForgeryToken()


        <!-- ================= BRANCH ================= -->

        <div class="branch-card">

            <div class="branch-title">

                Select Branch

            </div>

            <select asp-for="BranchId"
                    class="form-select rms-select"
                    required>

                <option value="">
                    -- Select a branch --
                </option>

                @foreach (var branch in Model.Branches)
                {
                    <option value="@branch.BranchId">

                        @branch.Address

                    </option>
                }

            </select>

            <span asp-validation-for="BranchId"
                  class="text-danger">
            </span>

        </div>


        <!-- ================= MENU ITEMS ================= -->
        @foreach (var categoryGroup in Model.AvailableMenuItems
                            .GroupBy(x => x.Category))
        {

            <!-- CATEGORY -->

            <div class="category-title">

                <h4>
                    @categoryGroup.Key
                </h4>

                <div class="category-line"></div>

            </div>


            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

                @foreach (var item in categoryGroup)
                {

                    var index = Model.AvailableMenuItems
                        .ToList()
                        .IndexOf(item);


                    <div class="col">

                        <div class="menu-card">


                            <!-- IMAGE -->
                            @if (!string.IsNullOrEmpty(item.ItemImage))
                            {

                                <img src="@item.ItemImage"
                                     class="menu-image"
                                     alt="@item.ItemName" />

                            }
                            else
                            {

                                <div class="no-image">

                                    No Image Available

                                </div>

                            }


                            <!-- BODY -->

                            <div class="menu-card-body">


                                <!-- NAME -->

                                <div class="menu-name">

                                    @item.ItemName

                                </div>


                                <!-- DESCRIPTION -->

                                <div class="menu-description">

                                    @item.Description

                                </div>


                                <!-- PRICE -->

                                <div class="menu-price">

                                    @item.ItemPrice.ToString("0.00") EGP

                                </div>


                                <!-- ITEM ID -->

                                <input type="hidden"
                                       name="Items[@index].ItemId"
                                       value="@item.ItemId" />


                                <!-- SELECT -->

                                <div class="select-item">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="Items[@index].IsSelected"
                                               value="true"
                                               id="item-@item.ItemId" />

                                        <label class="form-check-label"
                                               for="item-@item.ItemId">

                                            Add to Order

                                        </label>

                                    </div>

                                </div>


                                <!-- QUANTITY -->

                                <div class="mt-auto">

                                    <label class="quantity-label">

                                        Quantity

                                    </label>

                                    <input type="number"
                                           name="Items[@index].Quantity"
                                           value="1"
                                           min="1"
                                           class="form-control quantity-input" />

                                </div>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }


        <!-- ================= ACTIONS ================= -->

        <div class="order-actions">

            <button type="submit"
                    class="btn btn-submit-order">

                Submit Order

            </button>


            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-cancel-order">

                Cancel

            </a>

        </div>

    </form>

</div>