@model IEnumerable<RestaurantManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "Payments";

    var totalPayments = Model.Count();

    var completedPayments =
        Model.Count(x => x.PaymentStatus == "Completed");

    var pendingPayments =
        Model.Count(x => x.PaymentStatus == "Pending");

    var totalAmount =
        Model.Sum(x => x.Amount);
}


<div class="container-fluid">


    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-white mb-1">
                Payments
            </h2>

            <p class="text-secondary mb-0">
                Manage all restaurant payments
            </p>

        </div>

    </div>


    <!-- ============================= -->
    <!-- STATISTICS -->
    <!-- ============================= -->

    <div class="row g-3 mb-4">


        <!-- Total Payments -->

        <div class="col-md-3">

            <div class="card bg-dark border-secondary h-100">

                <div class="card-body">

                    <p class="text-secondary mb-1">
                        Total Payments
                    </p>

                    <h2 class="text-white fw-bold mb-0">
                        @totalPayments
                    </h2>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-md-3">

            <div class="card bg-dark border-success h-100">

                <div class="card-body">

                    <p class="text-secondary mb-1">
                        Completed
                    </p>

                    <h2 class="text-success fw-bold mb-0">
                        @completedPayments
                    </h2>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-md-3">

            <div class="card bg-dark border-warning h-100">

                <div class="card-body">

                    <p class="text-secondary mb-1">
                        Pending
                    </p>

                    <h2 class="text-warning fw-bold mb-0">
                        @pendingPayments
                    </h2>

                </div>

            </div>

        </div>


        <!-- Total Amount -->

        <div class="col-md-3">

            <div class="card bg-dark border-danger h-100">

                <div class="card-body">

                    <p class="text-secondary mb-1">
                        Total Amount
                    </p>

                    <h2 class="text-danger fw-bold mb-0">

                        @totalAmount.ToString("0.00")

                        <small class="fs-6">
                            EGP
                        </small>

                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- PAYMENTS TABLE -->
    <!-- ============================= -->

    <div class="card bg-dark border-secondary">


        <!-- Header -->

        <div class="card-header bg-dark border-secondary">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="text-white mb-0">
                    All Payments
                </h5>

                <span class="badge bg-danger">
                    @totalPayments Payments
                </span>

            </div>

        </div>


        <!-- Body -->

        <div class="card-body p-0">


            @if (!Model.Any())
            {
                <!-- ============================= -->
                <!-- EMPTY -->
                <!-- ============================= -->

                <div class="text-center py-5">

                    <h5 class="text-secondary">
                        No Payments Found
                    </h5>

                    <p class="text-secondary mb-0">
                        There are no payments available.
                    </p>

                </div>
            }
            else
            {

                <!-- ============================= -->
                <!-- TABLE -->
                <!-- ============================= -->

                <div class="table-responsive">

                    <table class="table table-dark table-hover align-middle mb-0">


                        <thead>

                            <tr>

                                <th class="px-4">
                                    Payment
                                </th>

                                <th>
                                    Order
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Method
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var payment in Model)
                            {
                                <tr>


                                    <!-- Payment ID -->

                                    <td class="px-4">

                                        <span class="fw-bold rms-red">

                                            #@payment.PaymentId

                                        </span>

                                    </td>


                                    <!-- Order ID -->

                                    <td>

                                        <span class="text-white fw-semibold">

                                            #@payment.OrderId

                                        </span>

                                    </td>


                                    <!-- Amount -->

                                    <td>

                                        <span class="fw-bold text-success">

                                            @payment.Amount.ToString("0.00")
                                            EGP

                                        </span>

                                    </td>


                                    <!-- Payment Method -->

                                    <td>

                                        @if (payment.PaymentMethod == "Cash")
                                        {
                                            <span class="badge bg-secondary">
                                                Cash
                                            </span>
                                        }
                                        else if (payment.PaymentMethod == "Card" ||
                                                 payment.PaymentMethod == "Visa")
                                        {
                                            <span class="badge bg-primary">
                                                @payment.PaymentMethod
                                            </span>
                                        }
                                        else if (payment.PaymentMethod == "Wallet")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Wallet
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @payment.PaymentMethod
                                            </span>
                                        }

                                    </td>


                                    <!-- Date -->

                                    <td>

                                        <span class="text-secondary">

                                            @payment.Date.ToString(
                                                "dd/MM/yyyy HH:mm"
                                            )

                                        </span>

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (payment.PaymentStatus == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (payment.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (payment.PaymentStatus == "Failed")
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @payment.PaymentStatus
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>