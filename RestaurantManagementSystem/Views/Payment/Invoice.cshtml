@model RestaurantManagementSystem.Models.Order

@{
    ViewData["Title"] = "Invoice";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Invoice - Order #@Model.OrderId
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 30px;
                background: #0d0d0d;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .invoice {
                max-width: 900px;
                margin: auto;
                background: #111;
                border: 1px solid #333;
                border-radius: 12px;
                padding: 35px;
            }

            /* ================= HEADER ================= */

            .invoice-header {
                margin-top: 50px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-bottom: 25px;
                border-bottom: 1px solid #333;
            }

            .logo {
                color: #8b0000;
                font-size: 32px;
                font-weight: bold;
                letter-spacing: 2px;
                margin: 0;
            }

            .subtitle {
                color: #888;
                margin-top: 5px;
            }

            .invoice-number {
                text-align: right;
            }

                .invoice-number span {
                    color: #aaa;
                    display: block;
                    margin-bottom: 5px;
                }

                .invoice-number strong {
                    color: #fff;
                    font-size: 20px;
                }

            /* ================= ORDER INFO ================= */

            .info-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                margin-bottom: 30px;
            }

            .info-card {
                background: #181818;
                border: 1px solid #333;
                border-radius: 8px;
                padding: 18px;
            }

                .info-card h4 {
                    color: #8b0000;
                    margin-top: 0;
                    margin-bottom: 15px;
                }

                .info-card p {
                    margin: 8px 0;
                    color: #ccc;
                }

                .info-card strong {
                    color: #fff;
                }

            /* ================= STATUS ================= */

            .status {
                display: inline-block;
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: bold;
            }

            .status-confirmed {
                background: #198754;
                color: white;
            }

            .status-pending {
                background: #ffc107;
                color: #111;
            }

            .status-cancelled {
                background: #dc3545;
                color: white;
            }

            /* ================= ITEMS ================= */

            .section-title {
                margin-bottom: 15px;
                font-size: 20px;
            }

            .items-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 25px;
            }

                .items-table th {
                    background: #8b0000;
                    color: white;
                    padding: 13px;
                    text-align: center;
                }

                .items-table td {
                    padding: 13px;
                    text-align: center;
                    border-bottom: 1px solid #333;
                    color: #ddd;
                }

                .items-table tbody tr:hover {
                    background: #181818;
                }

            .item-name {
                text-align: left !important;
                font-weight: bold;
                color: white !important;
            }

            /* ================= TOTAL ================= */

            .total-section {
                display: flex;
                justify-content: flex-end;
                margin-top: 20px;
            }

            .total-box {
                min-width: 280px;
                padding: 18px 20px;
                background: #181818;
                border: 1px solid #333;
                border-radius: 8px;
                text-align: right;
            }

            .total-label {
                color: #aaa;
                font-size: 15px;
            }

            .total-price {
                display: block;
                color: #fff;
                font-size: 27px;
                font-weight: bold;
                margin-top: 5px;
            }

                .total-price span {
                    color: #8b0000;
                }

            /* ================= PAYMENT ================= */

            .payment-section {
                margin-top: 30px;
                padding: 22px;
                background: #181818;
                border: 1px solid #333;
                border-radius: 8px;
            }

                .payment-section h3 {
                    margin-top: 0;
                    margin-bottom: 18px;
                }

                .payment-section label {
                    display: block;
                    margin-bottom: 8px;
                    color: #ccc;
                }

                .payment-section select {
                    width: 100%;
                    padding: 12px;
                    background: #0d0d0d;
                    color: white;
                    border: 1px solid #444;
                    border-radius: 6px;
                    margin-bottom: 15px;
                }

            .pay-btn {
                width: 100%;
                padding: 12px;
                border: none;
                border-radius: 6px;
                background: #198754;
                color: white;
                font-size: 16px;
                cursor: pointer;
            }

                .pay-btn:hover {
                    background: #157347;
                }

            /* ================= PRINT ================= */

            .actions {
                display: flex;
                justify-content: center;
                gap: 10px;
                margin-top: 25px;
            }

            .print-btn {
                padding: 11px 22px;
                border: none;
                border-radius: 6px;
                background: #8b0000;
                color: white;
                cursor: pointer;
                font-size: 15px;
            }

                .print-btn:hover {
                    background: #b22222;
                }

            .back-btn {
                padding: 11px 22px;
                border-radius: 6px;
                background: transparent;
                color: #ccc;
                border: 1px solid #444;
                cursor: pointer;
                font-size: 15px;
            }

                .back-btn:hover {
                    background: #222;
                    color: white;
                }

            /* ================= FOOTER ================= */

            .invoice-footer {
                text-align: center;
                color: #666;
                margin-top: 30px;
                padding-top: 20px;
                border-top: 1px solid #333;
                font-size: 13px;
            }

            /* ================= RESPONSIVE ================= */

            @@media (max-width: 700px) {

                body {
                    padding: 10px;
                }

                .invoice {
                    padding: 20px;
                }

                .invoice-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }

                .invoice-number {
                    text-align: left;
                }

                .info-grid {
                    grid-template-columns: 1fr;
                }

                .items-table {
                    font-size: 13px;
                }

                    .items-table th,
                    .items-table td {
                        padding: 8px;
                    }

                .total-section {
                    justify-content: stretch;
                }

                .total-box {
                    width: 100%;
                }
            }

            /* ================= PRINT MODE ================= */

            @@media print {

                body {
                    background: white;
                    color: black;
                    padding: 0;
                }

                .invoice {
                    max-width: 100%;
                    border: none;
                    box-shadow: none;
                    background: white;
                    color: black;
                    padding: 0;
                }

                .payment-section,
                .actions {
                    display: none;
                }

                .invoice-header {
                    border-bottom: 2px solid #333;
                }

                .logo {
                    color: #8b0000;
                }

                .info-card,
                .total-box {
                    background: white;
                    border: 1px solid #ccc;
                }

                    .info-card p,
                    .subtitle,
                    .total-label {
                        color: #333;
                    }

                    .info-card strong,
                    .total-price {
                        color: #111;
                    }

                .items-table th {
                    background: #333;
                }

                .items-table td {
                    color: #111;
                    border-bottom: 1px solid #ccc;
                }

                .invoice-footer {
                    color: #555;
                }
            }

    </style>

</head>


<body>

    <div class="invoice">


        <!-- ================= HEADER ================= -->

        <div class="invoice-header">

            <div>

                <h1 class="logo">
                    RMS
                </h1>

                <div class="subtitle">
                    Restaurant Management System
                </div>

            </div>


            <div class="invoice-number">

                <span>
                    Invoice
                </span>

                <strong>
                    #@Model.OrderId
                </strong>

            </div>

        </div>


        <!-- ================= ORDER INFORMATION ================= -->

        <div class="info-grid">


            <div class="info-card">

                <h4>
                    Customer Information
                </h4>

                <p>
                    <strong>User ID:</strong>
                    @Model.UserId
                </p>

                <p>
                    <strong>Email:</strong>
                    @(Model.User?.Email ?? "N/A")
                </p>

            </div>


            <div class="info-card">

                <h4>
                    Order Information
                </h4>

                <p>
                    <strong>Branch:</strong>
                    @(Model.Branch?.Address ?? "N/A")
                </p>

                <p>
                    <strong>Date:</strong>
                    @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </p>

                <p>

                    <strong>Status:</strong>

                    @if (Model.OrderStatus == "Confirmed")
                    {
                        <span class="status status-confirmed">
                            Confirmed
                        </span>
                    }
                    else if (Model.OrderStatus == "Pending")
                    {
                        <span class="status status-pending">
                            Pending
                        </span>
                    }
                    else if (Model.OrderStatus == "Cancelled")
                    {
                        <span class="status status-cancelled">
                            Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="status">
                            @Model.OrderStatus
                        </span>
                    }

                </p>

            </div>

        </div>


        <!-- ================= ORDER ITEMS ================= -->

        <h3 class="section-title">
            Order Items
        </h3>


        <table class="items-table">

            <thead>

                <tr>

                    <th>
                        Item
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Unit Price
                    </th>

                    <th>
                        Subtotal
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model.OrderItems)
                {
                    <tr>

                        <td class="item-name">
                            @item.Item.ItemName
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @item.ItemPrice.ToString("0.00") EGP
                        </td>

                        <td>
                            @((item.ItemPrice * item.Quantity).ToString("0.00")) EGP
                        </td>

                    </tr>
                }

            </tbody>

        </table>


        <!-- ================= TOTAL ================= -->

        <div class="total-section">

            <div class="total-box">

                <div class="total-label">
                    Total Amount
                </div>

                <span class="total-price">

                    <span>
                        @Model.TotalPrice.ToString("0.00")
                    </span>

                    EGP

                </span>

            </div>

        </div>


        <!-- ================= PAYMENT ================= -->
        @if (Model.OrderStatus == "Confirmed")
        {
            <div class="payment-section">

                <h3>
                    Payment
                </h3>

                <form asp-action="Pay"
                      asp-controller="Payment"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="orderId"
                           value="@Model.OrderId" />

                    <label for="paymentMethod">
                        Payment Method
                    </label>

                    <select id="paymentMethod"
                            name="paymentMethod"
                            required>

                        <option value="">
                            -- Select Payment Method --
                        </option>

                        <option value="Cash">
                            Cash
                        </option>

                        <option value="Visa">
                            Visa
                        </option>

                        <option value="Wallet">
                            Wallet
                        </option>

                    </select>

                    <button type="submit"
                            class="pay-btn">

                        Pay Now

                    </button>

                </form>

            </div>
        }


        <!-- ================= ACTIONS ================= -->

        <div class="actions">

            <button type="button"
                    onclick="window.print()"
                    class="print-btn">

                Print Invoice

            </button>


            <button type="button"
                    onclick="window.close()"
                    class="back-btn">

                Close

            </button>

        </div>


        <!-- ================= FOOTER ================= -->

        <div class="invoice-footer">

            Thank you for choosing RMS

            <br />

            Restaurant Management System © 2026

        </div>

    </div>

</body>

</html>