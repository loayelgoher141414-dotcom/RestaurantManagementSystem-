@model RestaurantManagementSystem.Models.Payment

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Payment Receipt</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background-color: black;
                margin: 0;
                padding: 30px;
                margin-top: 75px;
            }

            .receipt {
                max-width: 500px;
                margin: 20px auto;
                background: #8b0000;
                color: black;
                padding: 30px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }

            .header {
                text-align: center;
                border-bottom: 2px solid #333;
                padding-bottom: 15px;
                margin-top: 75px;
            }

                .header h1 {
                    margin: 0;
                }

            .details {
                margin-bottom: 20px;
            }

                .details p {
                    margin: 10px 0;
                }

            .total {
                border-top: 2px solid #333;
                padding-top: 15px;
                margin-top: 20px;
                font-size: 20px;
                font-weight: bold;
                text-align: right;
            }

            .buttons {
                text-align: center;
                margin-top: 30px;
            }

                .buttons button {
                    padding: 10px 20px;
                    border: none;
                    background-color: #333;
                    color: white;
                    cursor: pointer;
                    font-size: 16px;
                }

                    .buttons button:hover {
                        background-color: #555;
                    }

            @@media print {
                body {
                    background-color: white;
                    padding: 0;
                }

                .receipt {
                    box-shadow: none;
                    max-width: 100%;
                }

                .buttons {
                    display: none;
                }
            }
    </style>
</head>

<body>

    <div class="receipt">

        <div class="header">
            <h1>PAYMENT RECEIPT</h1>
            <p>Restaurant Management System</p>
        </div>

        <div class="details">

            <p>
                <strong>Payment ID:</strong>
                @Model.PaymentId
            </p>

            <p>
                <strong>Order ID:</strong>
                @Model.OrderId
            </p>

            <p>
                <strong>Date:</strong>
                @Model.Date.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Payment Method:</strong>
                @Model.PaymentMethod
            </p>

            <p>
                <strong>Payment Status:</strong>
                @Model.PaymentStatus
            </p>

        </div>

        <div class="total">
            Amount:
            @Model.Amount.ToString("0.00") EGP
        </div>

        <div class="buttons">
            <button onclick="window.print()">
                Print Receipt
            </button>
        </div>

    </div>

</body>
</html>