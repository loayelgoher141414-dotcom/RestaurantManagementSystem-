@model RestaurantManagementSystem.Models.Payment

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Payment Receipt</title>

    <style>

            /* ================================
                       PAGE
                    ================================= */

            body {
                margin: 0;
                padding: 0;
                background-color: #0d0d0d;
                color: white;
                font-family: Arial, sans-serif;
            }


            /* ================================
                       RECEIPT CONTAINER
                    ================================= */

            .receipt-page {
                min-height: calc(100vh - 70px);
                display: flex;
                justify-content: center;
                align-items: flex-start;
                padding: 100px 20px 40px;
                box-sizing: border-box;
            }


            /* ================================
                       RECEIPT
                    ================================= */

            .receipt {
                width: 100%;
                max-width: 550px;
                background: #8b0000;
                color: #111;
                padding: 35px;
                box-sizing: border-box;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
                border: 1px solid rgba(255, 255, 255, 0.08);
            }


            /* ================================
                       HEADER
                    ================================= */

            .header {
                text-align: center;
                border-bottom: 2px solid #222;
                padding-bottom: 20px;
                margin-bottom: 25px;
            }

                .header h1 {
                    margin: 0 0 8px 0;
                    font-size: 30px;
                    letter-spacing: 2px;
                    font-weight: 800;
                }

                .header p {
                    margin: 0;
                    font-size: 14px;
                    opacity: 0.8;
                }


            /* ================================
                       DETAILS
                    ================================= */

            .details {
                margin-bottom: 25px;
            }

                .details p {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 20px;
                    margin: 0;
                    padding: 14px 0;
                    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
                    font-size: 15px;
                }

                .details strong {
                    font-weight: 700;
                }

                .details span {
                    text-align: right;
                }


            /* ================================
                       TOTAL
                    ================================= */

            .total {
                border-top: 2px solid #222;
                padding-top: 20px;
                margin-top: 10px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 21px;
                font-weight: bold;
            }


            /* ================================
                       BUTTONS
                    ================================= */

            .buttons {
                text-align: center;
                margin-top: 30px;
            }

                .buttons button {
                    padding: 12px 28px;
                    border: none;
                    border-radius: 6px;
                    background-color: #111;
                    color: white;
                    cursor: pointer;
                    font-size: 15px;
                    font-weight: 600;
                    transition: 0.3s ease;
                }

                    .buttons button:hover {
                        background-color: #222;
                        transform: translateY(-2px);
                    }


            /* ================================
                       RESPONSIVE
                    ================================= */

            @@media (max-width: 600px) {

                .receipt-page {
                    padding: 25px 15px;
                }

                .receipt {
                    padding: 25px 20px;
                }

                .header h1 {
                    font-size: 24px;
                }

                .details p {
                    font-size: 14px;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 5px;
                }

                .details span {
                    text-align: left;
                }

                .total {
                    font-size: 18px;
                }
            }


            /* ================================
                       PRINT
                    ================================= */

            @@media print {

                body {
                    background: white;
                    color: black;
                }

                .receipt-page {
                    min-height: auto;
                    padding: 0;
                    display: block;
                }

                .receipt {
                    max-width: 100%;
                    width: 100%;
                    box-shadow: none;
                    border: none;
                    border-radius: 0;
                    margin: 0;
                    padding: 30px;
                    background: white;
                }

                .buttons {
                    display: none;
                }
            }

    </style>

</head>

<body>

    <div class="receipt-page">

        <div class="receipt">

            <!-- ================================
                 HEADER
            ================================= -->

            <div class="header">

                <h1>
                    PAYMENT RECEIPT
                </h1>

                <p>
                    Restaurant Management System
                </p>

            </div>


            <!-- ================================
                 PAYMENT DETAILS
            ================================= -->

            <div class="details">

                <p>
                    <strong>Payment ID:</strong>

                    <span>
                        @Model.PaymentId
                    </span>
                </p>


                <p>
                    <strong>Order ID:</strong>

                    <span>
                        @Model.OrderId
                    </span>
                </p>


                <p>
                    <strong>Date:</strong>

                    <span>
                        @Model.Date.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </p>


                <p>
                    <strong>Payment Method:</strong>

                    <span>
                        @Model.PaymentMethod
                    </span>
                </p>


                <p>
                    <strong>Payment Status:</strong>

                    <span>
                        @Model.PaymentStatus
                    </span>
                </p>

            </div>


            <!-- ================================
                 TOTAL
            ================================= -->

            <div class="total">

                <span>
                    Amount
                </span>

                <span>
                    @Model.Amount.ToString("0.00") EGP
                </span>

            </div>


            <!-- ================================
                 PRINT BUTTON
            ================================= -->

            <div class="buttons">

                <button onclick="window.print()">
                    Print Receipt
                </button>

            </div>

        </div>

    </div>

</body>
</html>
