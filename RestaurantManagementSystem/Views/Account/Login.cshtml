@model RestaurantManagementSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>

    /* ================= LOGIN PAGE ================= */

    .login-page {
        min-height: calc(100vh - 70px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background-color: #0d0d0d;
    }


    /* ================= LOGIN CARD ================= */

    .login-card {
        width: 100%;
        max-width: 450px;
        background-color: #111;
        border: 1px solid #292929;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
    }


    /* ================= LOGO ================= */

    .login-logo {
        text-align: center;
        margin-bottom: 8px;
        color: #8b0000;
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .login-title {
        text-align: center;
        color: white;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .login-subtitle {
        text-align: center;
        color: #777;
        margin-bottom: 30px;
        font-size: 0.9rem;
    }


    /* ================= FORM ================= */

    .login-label {
        color: #ccc;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .login-input {
        width: 100%;
        background-color: #0d0d0d;
        color: white;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        padding: 12px 14px;
        transition: 0.2s;
    }

        .login-input::placeholder {
            color: #666;
        }

        .login-input:focus {
            background-color: #0d0d0d;
            color: white;
            border-color: #8b0000;
            outline: none;
            box-shadow: 0 0 0 2px rgba(139, 0, 0, 0.15);
        }


    /* ================= REMEMBER ME ================= */

    .login-check {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #aaa;
    }

        .login-check input {
            background-color: #0d0d0d;
            border-color: #555;
        }

            .login-check input:checked {
                background-color: #8b0000;
                border-color: #8b0000;
            }


    /* ================= BUTTON ================= */

    .login-btn {
        width: 100%;
        background-color: #8b0000;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: 0.2s;
        margin-top: 10px;
    }

        .login-btn:hover {
            background-color: #b22222;
            color: white;
            transform: translateY(-1px);
        }


    /* ================= REGISTER ================= */

    .register-text {
        text-align: center;
        margin-top: 25px;
        color: #777;
        font-size: 0.9rem;
    }

    .register-link {
        color: #dc3545;
        text-decoration: none;
        font-weight: 600;
    }

        .register-link:hover {
            color: #ff4d5a;
            text-decoration: underline;
        }


    /* ================= VALIDATION ================= */

    .validation-error {
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 5px;
    }

    .validation-summary {
        background-color: rgba(139, 0, 0, 0.12);
        border: 1px solid #8b0000;
        border-radius: 8px;
        padding: 10px 15px;
        color: #dc3545;
        margin-bottom: 20px;
    }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 576px) {

        .login-page {
            padding: 25px 15px;
        }

        .login-card {
            padding: 25px 20px;
        }

        .login-logo {
            font-size: 2rem;
        }

        .login-title {
            font-size: 1.5rem;
        }
    }

</style>


<div class="login-page">

    <div class="login-card">


        <!-- LOGO -->

        <div class="login-logo">
            RMS
        </div>


        <!-- TITLE -->

        <h2 class="login-title">
            Welcome Back
        </h2>

        <p class="login-subtitle">
            Login to your Restaurant Management System account
        </p>


        <!-- FORM -->

        <form asp-action="Login"
              asp-controller="Account"
              method="post">

            @Html.AntiForgeryToken()


            <!-- Return URL -->

            <input type="hidden"
                   asp-for="ReturnUrl" />


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- EMAIL -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="login-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="login-input"
                       placeholder="Enter your email"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="validation-error">
                </span>

            </div>


            <!-- PASSWORD -->

            <div class="mb-3">

                <label asp-for="Password"
                       class="login-label">
                    Password
                </label>

                <input asp-for="Password"
                       class="login-input"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"
                      class="validation-error">
                </span>

            </div>


            <!-- REMEMBER ME -->

            <div class="login-check mb-3">

                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe">
                    Remember me
                </label>

            </div>


            <!-- LOGIN -->

            <button type="submit"
                    class="login-btn">

                Login

            </button>

        </form>


        <!-- REGISTER -->

        <div class="register-text">

            Don't have an account?

            <a asp-controller="Account"
               asp-action="Register"
               class="register-link">

                Register

            </a>

        </div>


    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}