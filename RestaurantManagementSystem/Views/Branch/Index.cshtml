@model IEnumerable<Branch>

@{
    ViewData["Title"] = "Branches";
}

<style>

    /* ================= BRANCHES PAGE ================= */

    .branches-page {
        min-height: calc(100vh - 70px);
        padding: 35px 4%;
        background-color: #0d0d0d;
        color: white;
    }


    /* ================= HEADER ================= */

    .branches-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .branches-header h2 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .branches-header p {
            color: #777;
            margin: 0;
        }


    /* ================= ADD BUTTON ================= */

    .btn-add-branch {
        background-color: #8b0000;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-add-branch:hover {
            background-color: #b22222;
            color: white;
        }


    /* ================= SUCCESS MESSAGE ================= */

    .success-message {
        background-color: rgba(25, 135, 84, 0.12);
        border: 1px solid #198754;
        color: #75d6a1;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }


    /* ================= TABLE CARD ================= */

    .branches-card {
        background-color: #111;
        border: 1px solid #292929;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    }


    /* ================= TABLE ================= */

    .branches-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        color: white;
    }

        .branches-table thead {
            background-color: #191919;
        }

        .branches-table th {
            color: #aaa;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 16px;
            border-bottom: 1px solid #333;
        }

        .branches-table td {
            padding: 16px;
            border-bottom: 1px solid #252525;
            vertical-align: middle;
            color: #ddd;
        }

        .branches-table tbody tr {
            transition: 0.2s;
        }

            .branches-table tbody tr:hover {
                background-color: #181818;
            }

            .branches-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* ================= BRANCH ID ================= */

    .branch-id {
        color: #8b0000 !important;
        font-weight: 700;
    }


    /* ================= ACTIONS ================= */

    .branch-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

        .branch-actions a {
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 0.8rem;
            text-decoration: none;
            transition: 0.2s;
        }


    /* ORDERS */

    .btn-orders {
        background-color: #333;
        border: 1px solid #555;
        color: white;
    }

        .btn-orders:hover {
            background-color: #444;
            color: white;
        }


    /* EDIT */

    .btn-edit {
        background-color: #8b0000;
        border: 1px solid #8b0000;
        color: white;
    }

        .btn-edit:hover {
            background-color: #b22222;
            color: white;
        }


    /* DETAILS */

    .btn-details {
        background-color: transparent;
        border: 1px solid #555;
        color: #aaa;
    }

        .btn-details:hover {
            background-color: #222;
            border-color: #777;
            color: white;
        }


    /* DELETE */

    .btn-delete {
        background-color: #5c1111;
        border: 1px solid #7a1b1b;
        color: #ffb3b3;
    }

        .btn-delete:hover {
            background-color: #dc3545;
            border-color: #dc3545;
            color: white;
        }


    /* ================= EMPTY STATE ================= */

    .empty-branches {
        text-align: center;
        padding: 60px 20px;
        color: #777;
    }

        .empty-branches h5 {
            color: #aaa;
            margin-bottom: 8px;
        }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 900px) {

        .branches-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }

        .branches-card {
            overflow-x: auto;
        }

        .branches-table {
            min-width: 750px;
        }
    }


    @@media (max-width: 576px) {

        .branches-page {
            padding: 25px 15px;
        }

        .branches-header h2 {
            font-size: 1.6rem;
        }
    }

</style>


<div class="branches-page">


    <!-- ================= HEADER ================= -->

    <div class="branches-header">

        <div>

            <h2>
                Branches
            </h2>

            <p>
                Manage restaurant branches and their orders.
            </p>

        </div>


        <a asp-action="Create"
           class="btn-add-branch">

            + Add Branch

        </a>

    </div>


    <!-- ================= SUCCESS MESSAGE ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="success-message">

            @TempData["Success"]

        </div>
    }


    <!-- ================= BRANCHES TABLE ================= -->

    <div class="branches-card">

        @if (Model != null && Model.Any())
        {

            <table class="branches-table">

                <thead>

                    <tr>

                        <th>
                            ID
                        </th>

                        <th>
                            Address
                        </th>

                        <th>
                            Phone Number
                        </th>

                        <th style="width: 330px;">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>


                            <!-- ID -->

                            <td class="branch-id">

                                #@item.BranchId

                            </td>


                            <!-- ADDRESS -->

                            <td>

                                @item.Address

                            </td>


                            <!-- PHONE -->

                            <td>

                                @item.BranchPhoneNumber

                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="branch-actions">


                                    <!-- ORDERS -->

                                    <a asp-action="Orders"
                                       asp-route-id="@item.BranchId"
                                       class="btn-orders">

                                        Orders

                                    </a>


                                    <!-- EDIT -->

                                    <a asp-action="Edit"
                                       asp-route-id="@item.BranchId"
                                       class="btn-edit">

                                        Edit

                                    </a>


                                    <!-- DETAILS -->

                                    <a asp-action="Details"
                                       asp-route-id="@item.BranchId"
                                       class="btn-details">

                                        Details

                                    </a>


                                    <!-- DELETE -->

                                    <a asp-action="Delete"
                                       asp-route-id="@item.BranchId"
                                       class="btn-delete">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        }
        else
        {

            <!-- ================= EMPTY ================= -->

            <div class="empty-branches">

                <h5>
                    No branches found
                </h5>

                <p>
                    Add your first restaurant branch to get started.
                </p>

                <a asp-action="Create"
                   class="btn-add-branch">

                    + Add Branch

                </a>

            </div>

        }

    </div>

</div>