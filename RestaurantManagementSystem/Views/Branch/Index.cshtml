@model IEnumerable<Branch>

@{
    ViewData["Title"] = "Branches";
}

<h1>Branches</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Branch</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.BranchId)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.BranchPhoneNumber)</th>
            <th>Manager</th>
            <th style="width: 320px;">Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.BranchId</td>
            <td>@item.Address</td>
            <td>@item.BranchPhoneNumber</td>
            <td>@(item.Manager != null ? item.Manager.UserName : "Not assigned")</td>
            <td>
                <a asp-action="Orders" asp-route-id="@item.BranchId" class="btn btn-sm btn-info">Orders</a>
                <a asp-action="AssignManager" asp-route-id="@item.BranchId" class="btn btn-sm btn-warning">Assign Manager</a>
                <a asp-action="Edit" asp-route-id="@item.BranchId" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.BranchId" class="btn btn-sm btn-outline-dark">Details</a>
                <a asp-action="Delete" asp-route-id="@item.BranchId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
