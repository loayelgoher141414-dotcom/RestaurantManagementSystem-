@model IEnumerable<Order>
@{
    var branch = (Branch)ViewBag.Branch;
    ViewData["Title"] = "Orders by Branch";
}

<h1>Orders</h1>
<h5 class="text-muted">Branch: @branch.Address</h5>

<a asp-action="Index" class="btn btn-outline-secondary mb-3">Back to Branches</a>

@if (!Model.Any())
{
    <p>No orders found for this branch.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.OrderId)</th>
                <th>Customer/User</th>
                <th>@Html.DisplayNameFor(model => model.TotalPrice)</th>
                <th>@Html.DisplayNameFor(model => model.OrderStatus)</th>
                <th># Items</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var order in Model)
    {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.User?.UserName</td>
                <td>@order.TotalPrice.ToString("C")</td>
                <td>@order.OrderStatus</td>
                <td>@order.OrderItems.Count</td>
            </tr>
    }
        </tbody>
    </table>
}
