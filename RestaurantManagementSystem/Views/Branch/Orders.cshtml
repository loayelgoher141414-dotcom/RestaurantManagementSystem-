@model IEnumerable<Order>

@{
    var branch = (Branch)ViewBag.Branch;
    ViewData["Title"] = "Branch Orders";
}

<style>

    /* ================= BRANCH ORDERS PAGE ================= */

    .branch-orders-page {
        min-height: calc(100vh - 70px);
        padding: 35px 4%;
        background-color: #0d0d0d;
        color: white;
    }


    /* ================= HEADER ================= */

    .orders-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 25px;
    }

        .orders-header h2 {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .orders-header p {
            color: #777;
            margin: 0;
        }

    .branch-name {
        color: #8b0000;
        font-weight: 600;
    }


    /* ================= BACK BUTTON ================= */

    .btn-back-branches {
        background-color: transparent;
        color: #aaa;
        border: 1px solid #444;
        border-radius: 7px;
        padding: 9px 16px;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-back-branches:hover {
            background-color: #222;
            color: white;
            border-color: #666;
        }


    /* ================= TABLE CARD ================= */

    .orders-card {
        background-color: #111;
        border: 1px solid #292929;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    }


    /* ================= TABLE ================= */

    .orders-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        color: white;
    }

        .orders-table thead {
            background-color: #191919;
        }

        .orders-table th {
            color: #aaa;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 16px;
            border-bottom: 1px solid #333;
        }

        .orders-table td {
            padding: 16px;
            border-bottom: 1px solid #252525;
            vertical-align: middle;
            color: #ddd;
        }

        .orders-table tbody tr {
            transition: 0.2s;
        }

            .orders-table tbody tr:hover {
                background-color: #181818;
            }

            .orders-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* ================= ORDER ID ================= */

    .order-id {
        color: #8b0000 !important;
        font-weight: 700;
    }


    /* ================= PRICE ================= */

    .order-price {
        font-weight: 600;
        color: #eee !important;
    }


    /* ================= STATUS ================= */

    .order-status {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        background-color: #333;
        color: #ddd;
    }

    .status-pending {
        background-color: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .status-confirmed {
        background-color: rgba(25, 135, 84, 0.15);
        color: #75d6a1;
        border: 1px solid rgba(25, 135, 84, 0.3);
    }

    .status-cancelled {
        background-color: rgba(220, 53, 69, 0.15);
        color: #ff8f9b;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }


    /* ================= ITEMS ================= */

    .items-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 28px;
        padding: 0 8px;
        background-color: #222;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        color: #ddd;
        font-size: 0.85rem;
    }


    /* ================= EMPTY STATE ================= */

    .empty-orders {
        text-align: center;
        padding: 65px 20px;
        color: #777;
    }

        .empty-orders h5 {
            color: #aaa;
            margin-bottom: 8px;
        }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 768px) {

        .branch-orders-page {
            padding: 25px 15px;
        }

        .orders-header {
            flex-direction: column;
            gap: 15px;
        }

        .orders-card {
            overflow-x: auto;
        }

        .orders-table {
            min-width: 700px;
        }
    }

</style>


<div class="branch-orders-page">


    <!-- ================= HEADER ================= -->

    <div class="orders-header">

        <div>

            <h2>
                Branch Orders
            </h2>

            <p>
                Orders for branch:
                <span class="branch-name">
                    @branch.Address
                </span>
            </p>

        </div>


        <a asp-action="Index"
           class="btn-back-branches">

            ← Back to Branches

        </a>

    </div>


    <!-- ================= ORDERS ================= -->

    <div class="orders-card">

        @if (!Model.Any())
        {

            <!-- EMPTY STATE -->

            <div class="empty-orders">

                <h5>
                    No Orders Found
                </h5>

                <p>
                    There are currently no orders for this branch.
                </p>

            </div>

        }
        else
        {

            <table class="orders-table">

                <thead>

                    <tr>

                        <th>
                            Order ID
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Total
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Items
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var order in Model)
                    {

                        var statusClass =
                            order.OrderStatus?.ToLower() switch
                            {
                                "pending" => "status-pending",
                                "confirmed" => "status-confirmed",
                                "cancelled" => "status-cancelled",
                                _ => ""
                            };


                        <tr>


                            <!-- ORDER ID -->

                            <td class="order-id">

                                #@order.OrderId

                            </td>


                            <!-- CUSTOMER -->

                            <td>

                                @order.User?.UserName

                            </td>


                            <!-- TOTAL -->

                            <td class="order-price">

                                @order.TotalPrice.ToString("0.00") EGP

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="order-status @statusClass">

                                    @order.OrderStatus

                                </span>

                            </td>


                            <!-- ITEMS -->

                            <td>

                                <span class="items-count">

                                    @order.OrderItems.Count

                                </span>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        }

    </div>

</div>