@model Branch

@{
    ViewData["Title"] = "Delete Branch";
}

<style>

    /* ================= DELETE PAGE ================= */

    .delete-page {
        min-height: calc(100vh - 70px);
        padding: 35px 5%;
        background-color: #0d0d0d;
        color: white;
    }


    /* ================= HEADER ================= */

    .delete-header {
        margin-bottom: 30px;
    }

        .delete-header h2 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .delete-header p {
            color: #777;
            margin: 0;
        }


    /* ================= CARD ================= */

    .delete-card {
        max-width: 650px;
        background-color: #111;
        border: 1px solid #5a1515;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    }


    /* ================= WARNING ================= */

    .delete-warning {
        background-color: rgba(139, 0, 0, 0.12);
        border: 1px solid #8b0000;
        border-radius: 10px;
        padding: 15px 18px;
        margin-bottom: 25px;
        color: #ddd;
    }

        .delete-warning strong {
            color: #dc3545;
        }


    /* ================= DETAILS ================= */

    .branch-details {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 30px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #191919;
        border: 1px solid #292929;
        border-radius: 8px;
        padding: 14px 16px;
    }

    .detail-label {
        color: #777;
        font-size: 0.85rem;
    }

    .detail-value {
        color: white;
        font-weight: 600;
        text-align: right;
    }


    /* ================= BUTTONS ================= */

    .delete-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 10px 22px;
        font-weight: 600;
        transition: 0.2s;
    }

        .delete-btn:hover {
            background-color: #b02a37;
            color: white;
        }

    .back-btn {
        background-color: transparent;
        color: #aaa;
        border: 1px solid #444;
        border-radius: 7px;
        padding: 10px 22px;
        text-decoration: none;
        transition: 0.2s;
    }

        .back-btn:hover {
            background-color: #222;
            color: white;
            border-color: #666;
        }


    /* ================= VALIDATION ================= */

    .validation-summary {
        color: #dc3545;
        margin-bottom: 15px;
    }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 768px) {

        .delete-page {
            padding: 25px 15px;
        }

        .delete-card {
            padding: 22px;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }

        .detail-value {
            text-align: left;
        }

        .delete-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .delete-actions button,
            .delete-actions a {
                width: 100%;
                text-align: center;
            }
    }

</style>


<div class="delete-page">


    <!-- ================= HEADER ================= -->

    <div class="delete-header">

        <h2>
            Delete Branch
        </h2>

        <p>
            Remove a restaurant branch from the system.
        </p>

    </div>


    <!-- ================= DELETE CARD ================= -->

    <div class="delete-card">


        <!-- WARNING -->

        <div class="delete-warning">

            <strong>Warning:</strong>

            Are you sure you want to delete this branch?

            <br />

            This action cannot be undone.

        </div>


        <!-- VALIDATION -->

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <!-- ================= BRANCH DETAILS ================= -->

        <div class="branch-details">


            <!-- ADDRESS -->

            <div class="detail-row">

                <span class="detail-label">
                    Branch Address
                </span>

                <span class="detail-value">
                    @Model.Address
                </span>

            </div>


            <!-- PHONE -->

            <div class="detail-row">

                <span class="detail-label">
                    Phone Number
                </span>

                <span class="detail-value">
                    @Model.BranchPhoneNumber
                </span>

            </div>


            <!-- ID -->

            <div class="detail-row">

                <span class="detail-label">
                    Branch ID
                </span>

                <span class="detail-value">
                    #@Model.BranchId
                </span>

            </div>

        </div>


        <!-- ================= ACTIONS ================= -->

        <form asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="BranchId" />


            <div class="delete-actions d-flex gap-2">

                <button type="submit"
                        class="delete-btn">

                    Delete Branch

                </button>

                <a asp-action="Index"
                   class="back-btn">

                    Back to Branches

                </a>

            </div>

        </form>

    </div>

</div>